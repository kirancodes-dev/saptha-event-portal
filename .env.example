# =========================================================
# .env.example — copy to .env and fill in. Never commit .env.
#
# Local development needs NOTHING from this file: with no DATABASE_URL the
# app uses a local SQLite file and generates its own dev secret key.
# Everything marked [PRODUCTION] is required when FLASK_ENV=production —
# the app refuses to start without it.
# =========================================================

# development | production
FLASK_ENV=development
LOG_LEVEL=INFO
BASE_URL=http://127.0.0.1:5001

# ── Security ──────────────────────────────────────────────
# [PRODUCTION] python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# [PRODUCTION] Extra key required on every Super Admin login (12+ chars)
MASTER_SECRET_KEY=
# Optional separate JWT signing key for /api/v1 (defaults to SECRET_KEY)
JWT_SECRET_KEY=

# ── Super Admin bootstrap ─────────────────────────────────
# Create the account with: python init_superadmin.py
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASS=

# ── Database ──────────────────────────────────────────────
# [PRODUCTION] PostgreSQL (Supabase, Neon, RDS, Cloud SQL, docker compose, ...)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# Local default when unset: SQLite file saptha_fallback.db in the project root
# Alternative to DATABASE_URL on Google Cloud (pip install 'cloud-sql-python-connector[pg8000]'):
# CLOUD_SQL_INSTANCE=project:region:instance
# DB_USER=postgres
# DB_PASS=
# DB_NAME=saptha

# ── Redis (sessions, rate limits, Celery) ─────────────────
# Recommended in production; without it sessions use the filesystem and
# Celery tasks run inline in the web request.
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── Login throttling ──────────────────────────────────────
# Failed logins (web and API) and password-reset requests allowed per IP and
# per account in any LOGIN_THROTTLE_WINDOW seconds; the next one gets 429.
# Counters live in Redis when REDIS_URL is set, otherwise in the database.
# If a whole lab shares one IP, raise the IP limit rather than the account one.
# LOGIN_THROTTLE_IP_LIMIT=5
# LOGIN_THROTTLE_ACCOUNT_LIMIT=5
# LOGIN_THROTTLE_WINDOW=60
# Failed logins per account in any hour, on top of the per-minute limit
# LOGIN_THROTTLE_ACCOUNT_HOURLY_LIMIT=20

# ── Email (pick one provider) ─────────────────────────────
# Gmail SMTP with an App Password: https://myaccount.google.com/apppasswords
MAIL_USER=
MAIL_PASS=
MAIL_TIMEOUT=10
# RESEND_API_KEY=
# BREVO_API_KEY=

# ── Optional integrations (features are skipped when unset) ─
GEMINI_API_KEY=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# Secret set on the Razorpay webhook (Dashboard → Webhooks, event payment.captured,
# URL https://<BASE_URL>/payment/webhook/razorpay). Without it the webhook answers 503.
# RAZORPAY_WEBHOOK_SECRET=
# Minutes an unpaid order holds a coupon use before giving it back (default 30)
# COUPON_HOLD_MINUTES=30
# STRIPE_API_KEY=
# STRIPE_WEBHOOK_SECRET=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_EMAIL=mailto:admin@example.edu
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# SENTRY_DSN=

# ── File storage ──────────────────────────────────────────
# local (default; files are lost on container redeploys) | s3 | gcs
STORAGE_TYPE=local
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_DEFAULT_REGION=
