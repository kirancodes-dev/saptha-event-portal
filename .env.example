# =========================================================
# .env.example — copy to .env and fill in. Never commit .env.
#
# Local development needs NOTHING from this file: with no DATABASE_URL the
# app uses a local SQLite file and generates its own dev secret key.
# Everything marked [PRODUCTION] is required when FLASK_ENV=production: the
# app refuses to start and names every missing or weak one at once
# (config.production_problems, UPG-20).
#
# Generate a random secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Use a new value for each secret, never one used before.
# =========================================================

# development | production
FLASK_ENV=development
LOG_LEVEL=INFO
# [PRODUCTION] The site's public https:// address; every emailed link uses it
BASE_URL=http://127.0.0.1:5001
# true redirects http to https and sends HSTS (default: true in production)
# FORCE_HTTPS=false
# Port the app listens on (Cloud Run sets it)
# PORT=8080

# ── Security ──────────────────────────────────────────────
# [PRODUCTION] 32+ random characters (generate as above)
SECRET_KEY=
# [PRODUCTION] Extra key required on every Super Admin login (12+ characters)
MASTER_SECRET_KEY=
# [PRODUCTION] Signs /api/v1 tokens; 32+ random characters, different from SECRET_KEY
JWT_SECRET_KEY=
# Access / refresh token lifetimes in seconds
# JWT_ACCESS_TOKEN_EXPIRES=900
# JWT_REFRESH_TOKEN_EXPIRES=604800
# Separate CSRF signing key (defaults to SECRET_KEY)
# WTF_CSRF_SECRET_KEY=
# Signs API v1 certificate IDs (defaults to SECRET_KEY)
# CERT_SECRET_KEY=

# ── Super Admin bootstrap ─────────────────────────────────
# Create the account with: python init_superadmin.py
# The password must be 12+ characters in production (a password manager's).
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASS=

# ── Database ──────────────────────────────────────────────
# [PRODUCTION] PostgreSQL (Supabase, Neon, RDS, Cloud SQL, docker compose, ...).
# Build or update the schema with `alembic upgrade head` (docs/DEPLOY.md).
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# Alternative to DATABASE_URL on Google Cloud (pip install 'cloud-sql-python-connector[pg8000]'):
# CLOUD_SQL_INSTANCE=project:region:instance
# DB_USER=postgres
# DB_PASS=
# DB_NAME=saptha
# Optional read replica for GET requests
# READ_REPLICA_URL=
# Connection pool (per process)
# PGBOUNCER_POOL_SIZE=20
# PGBOUNCER_MAX_OVERFLOW=10
# PGBOUNCER_POOL_RECYCLE=1800
# postgres (SQL, default) | firestore (legacy)
# DATABASE_TYPE=postgres
# Local SQLite file used when DATABASE_URL is unset (development only)
# LOCAL_SQLITE_PATH=saptha_fallback.db
# Only for a throwaway demo: let production run on SQLite
# ALLOW_SQLITE_IN_PRODUCTION=false
# Per-tenant PostgreSQL schemas (opt-in, experimental)
# MULTI_TENANT_SCHEMAS=false
# MULTI_TENANT_ENABLED=false
# DEFAULT_ORG_SLUG=snpsu

# ── Redis (sessions, rate limits, Celery) ─────────────────
# Optional. Without it, sessions and login throttling use the database, and
# background tasks run inline with the outbox (below).
# REDIS_URL=redis://localhost:6379/0
# RATELIMIT_STORAGE_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_RESULT_BACKEND=redis://localhost:6379/1
# Sessions: sqlalchemy (default, the database) | redis
# SESSION_TYPE=sqlalchemy
# Only for SESSION_TYPE=filesystem (not used in production)
# SESSION_FILE_DIR=
# SESSION_FILE_THRESHOLD=500

# ── Background tasks without a broker (UPG-18, docs/DEPLOY.md) ──
# Each task runs inline for at most this many seconds; failures and timeouts
# go to the outbox, retried by POST /internal/cron/outbox.
# TASK_INLINE_TIMEOUT=10
# TASK_INLINE_THREADS=8
# OUTBOX_MAX_ATTEMPTS=5

# ── Scheduled jobs ────────────────────────────────────────
# [PRODUCTION, unless CELERY_BROKER_URL is Redis] Cloud Scheduler or
# .github/workflows/cron.yml calls POST /internal/cron/<job> with this value
# in the X-Cron-Secret header (docs/DEPLOY.md). Unset, the endpoint answers 503.
# 24+ random characters (generate as above).
# CRON_SECRET=

# ── Login throttling ──────────────────────────────────────
# Failed logins (web and API) and password-reset requests allowed per IP and
# per account in any LOGIN_THROTTLE_WINDOW seconds; the next one gets 429.
# Counters live in Redis when REDIS_URL is set, otherwise in the database.
# If a whole lab shares one IP, raise the IP limit rather than the account one
# (about 50 on campus Wi-Fi).
# LOGIN_THROTTLE_IP_LIMIT=5
# LOGIN_THROTTLE_ACCOUNT_LIMIT=5
# LOGIN_THROTTLE_WINDOW=60
# Failed logins per account in any hour, on top of the per-minute limit
# LOGIN_THROTTLE_ACCOUNT_HOURLY_LIMIT=20

# ── Email ─────────────────────────────────────────────────
# [PRODUCTION] One provider. Brevo first: Brevo → Settings → SMTP & API → API Keys.
# BREVO_API_KEY=
# RESEND_API_KEY=
# [PRODUCTION] The sender, verified with the provider, e.g. SapthaEvent <events@your-university-domain>
# MAIL_FROM=
# Display name used with MAIL_USER when MAIL_FROM is unset
# MAIL_SENDER=SapthaEvent
# SMTP instead of an API (e.g. Gmail with an App Password: https://myaccount.google.com/apppasswords)
MAIL_USER=
MAIL_PASS=
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USE_SSL=false
MAIL_TIMEOUT=10
# Logo in emails and certificates (default: BASE_URL + /static/snpsu-logo.png)
# COLLEGE_LOGO_URL=

# ── Payments (Razorpay) ───────────────────────────────────
# Set all three or none (production refuses half a set-up). From the Razorpay
# Dashboard → Settings → API Keys, and Webhooks (event payment.captured,
# URL https://<BASE_URL>/payment/webhook/razorpay; the webhook secret is any
# random value you set there). Without the webhook secret the webhook answers 503.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# Minutes an unpaid order holds a coupon use before giving it back (default 30)
# COUPON_HOLD_MINUTES=30
# Development only: complete payments without Razorpay (refused in production)
# PAYMENT_SIMULATION=false
# STRIPE_API_KEY=
# STRIPE_WEBHOOK_SECRET=

# ── Monitoring ────────────────────────────────────────────
# Sentry is on when SENTRY_DSN is set (Sentry → Project → Settings → Client Keys).
# Personal data is never sent.
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1
# Set by Cloud Run; used to group logs by request and tag Sentry releases
# GOOGLE_CLOUD_PROJECT=
# K_REVISION=

# ── Web server (gunicorn.conf.py) ─────────────────────────
# WEB_CONCURRENCY=2
# WORKERS=2
# GUNICORN_WORKER_CLASS=sync

# ── Optional integrations (features are skipped when unset) ─
GEMINI_API_KEY=
# GOOGLE_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Web push: generate a key pair with `npx web-push generate-vapid-keys`
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_EMAIL=mailto:admin@example.edu
# Google / Microsoft sign-in (Google Cloud console → APIs & Services → Credentials;
# Azure portal → App registrations). Redirect URI: <BASE_URL>/auth/google/callback
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_MICROSOFT_CLIENT_ID=
# OAUTH_MICROSOFT_CLIENT_SECRET=
# Supabase client (only for Supabase-specific features; the database uses DATABASE_URL)
# SUPABASE_URL=
# SUPABASE_KEY=
# Legacy Firestore mode only (DATABASE_TYPE=firestore)
# FIREBASE_CREDENTIALS=
# FIREBASE_KEY_PATH=serviceAccountKey.json
# Unused APScheduler file (UPG-14): set to skip it
# NO_SCHEDULER=1

# ── File storage ──────────────────────────────────────────
# local (development only) | s3 | gcs
STORAGE_TYPE=local
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_DEFAULT_REGION=
# AWS_S3_CUSTOM_DOMAIN=
# GCS_BUCKET_NAME=
