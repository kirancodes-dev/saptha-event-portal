{
  "name": "saptha-event",
  "version": "1.0.0",
  "private": true,
  "description": "Capacitor wrapper for the SapthaEvent web portal",
  "scripts": {
    "build": "node build_static.js",
    "cap:init": "npx cap init sapthaevent com.sapthaevent.app --web-dir=static",
    "cap:add-android": "npx cap add android",
    "cap:copy": "npx cap copy android",
    "cap:open": "npx cap open android"
  },
  "devDependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/cli": "^6.0.0"
  }
}
